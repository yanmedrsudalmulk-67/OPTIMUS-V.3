{
  "name": "medical-tug-of-war",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch apps/realtime-server/src/index.ts",
    "dev:web": "next dev apps/web -p 3005 --hostname 0.0.0.0",
    "build": "prisma generate --schema packages/database/prisma/schema.prisma && next build apps/web",
    "start": "concurrently -k -n api,web \"tsx apps/realtime-server/src/index.ts\" \"next start apps/web -p 3005 --hostname 0.0.0.0\"",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma db push --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate --schema packages/database/prisma/schema.prisma",
    "setup:local": "tsx scripts/setup-local.ts",
    "db:backup": "tsx scripts/backup.ts",
    "format": "prettier --write apps packages scripts tests *.ts *.json *.md docker-compose.yml"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "9.8.2",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.183.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.183.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  }
}
