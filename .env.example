# Copy to .env. Choose your own local database password and admin password.
DATABASE_URL=postgresql://medical:CHANGE_ME@127.0.0.1:5432/medical?schema=public
POSTGRES_USER=medical
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=medical
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
API_PORT=4001
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Use your reachable LAN IP or HTTPS domain for smartphone invitations.
PUBLIC_APP_URL=http://localhost:3000
# Optional: direct API URL for reverse proxies that cannot proxy Socket.IO.
# NEXT_PUBLIC_REALTIME_URL=https://realtime.your-domain.example
INTERNAL_API_URL=http://127.0.0.1:4001
COOKIE_SECURE=false
